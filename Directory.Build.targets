<Project>

  <!--
    Rule 1 of .editorconfig, on every build. RCS0056 measures code only, so a long line inside a comment
    would pass unseen; this measures every compiled line, comments included.
  -->
  <PropertyGroup>
    <CheckLineWidth Condition="'$(CheckLineWidth)' == ''">true</CheckLineWidth>
    <MaxLineWidth Condition="'$(MaxLineWidth)' == ''">110</MaxLineWidth>
  </PropertyGroup>

  <UsingTask TaskName="MeasureLineWidth" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Root ParameterType="System.String" Required="true" />
      <MaxWidth ParameterType="System.Int32" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        foreach (Microsoft.Build.Framework.ITaskItem file in Files)
        {
            string path = file.GetMetadata("FullPath");
            if (!path.StartsWith(Root, System.StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            string relative = path.Substring(Root.Length).Replace('\\', '/');
            if (relative.Contains("/obj/") || relative.Contains("/bin/") || !System.IO.File.Exists(path))
            {
                continue;
            }

            string[] lines = System.IO.File.ReadAllLines(path);
            for (int index = 0; index < lines.Length; index++)
            {
                int width = lines[index].Length;
                if (width > MaxWidth)
                {
                    Log.LogError(
                        null, "SCOOP0056", null, path, index + 1, MaxWidth + 1, index + 1, width,
                        "Line is {0} characters, over the {1}-column limit. Name the piece, don't wrap it.",
                        width, MaxWidth
                    );
                }
            }
        }
        _Success = !Log.HasLoggedErrors;
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Skipped in IDE design-time builds, where errors would fail the project load. -->
  <Target Name="CheckLineWidth" BeforeTargets="CoreCompile"
          Condition="'$(CheckLineWidth)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_MeasuredLine Include="@(Compile)" />
      <_MeasuredLine Include="$(MSBuildProjectFullPath)" />
    </ItemGroup>
    <MeasureLineWidth Files="@(_MeasuredLine)" Root="$(MSBuildThisFileDirectory)"
                      MaxWidth="$(MaxLineWidth)" />
  </Target>

  <!-- `make install` exports SILKSONG_GAMES: game root folders separated by `;`, from local.mk. -->
  <Target Name="InstallPlugin">
    <Error Condition="'$(SILKSONG_GAMES)' == ''" Text="SILKSONG_GAMES is not set; see local.mk.example" />
    <ItemGroup>
      <_Game Include="$(SILKSONG_GAMES)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_Game.Identity)/BepInEx')" Text="no BepInEx in %(_Game.Identity)" />
    <!-- ScriptEngine aborts the whole reload when a DLL has no symbols next to it. -->
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb"
          DestinationFolder="%(_Game.Identity)/BepInEx/scripts/$(TargetName)" />
    <Message Importance="high" Text="installed into %(_Game.Identity)/BepInEx/scripts/$(TargetName)" />
  </Target>

</Project>
