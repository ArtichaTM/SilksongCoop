<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 5 plugin; the game runs Unity 6 Mono, which loads netstandard2.1. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SilksongCoop</RootNamespace>
  </PropertyGroup>

  <!-- Publicized game assemblies let patches touch private members without reflection. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compile-time only: the game and BepInEx provide these at runtime. -->
  <ItemGroup>
    <Reference Include="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCore)/0Harmony.dll" Private="false" />
    <Reference Include="$(GameManaged)/Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="$(GameManaged)/PlayMaker.dll" Private="false" Publicize="true" />
    <Reference Include="$(GameManaged)/TeamCherry.TK2D.dll" Private="false" Publicize="true" />
    <Reference Include="$(GameManaged)/TeamCherry.SharedUtils.dll" Private="false" />
    <Reference Include="$(GameManaged)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SilksongCoop.Tests" />
  </ItemGroup>

  <!-- `make install` passes PluginDir; the game paths live in the Makefile. -->
  <Target Name="InstallPlugin">
    <Error Condition="'$(PluginDir)' == ''" Text="PluginDir is not set; install through make" />
    <!-- ScriptEngine aborts the whole reload when a DLL has no symbols next to it. -->
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="installed into $(PluginDir)" />
  </Target>

</Project>
