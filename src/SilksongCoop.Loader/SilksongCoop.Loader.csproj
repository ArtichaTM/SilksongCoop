<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 5 plugin that keeps SilksongCoop up to date and starts it; dev installs don't use it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SilksongCoop.Loader</RootNamespace>
  </PropertyGroup>

  <!-- Compile-time only: the game and BepInEx provide these at runtime. -->
  <ItemGroup>
    <Reference Include="$(BepInExCore)/BepInEx.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(GameManaged)/UnityEngine.UnityWebRequestModule.dll" Private="false" />
  </ItemGroup>

  <!-- `make install` passes PluginDir; the game paths live in the Makefile. -->
  <Target Name="InstallPlugin">
    <Error Condition="'$(PluginDir)' == ''" Text="PluginDir is not set; install through make" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
    <Message Importance="high" Text="installed into $(PluginDir)" />
  </Target>

</Project>
