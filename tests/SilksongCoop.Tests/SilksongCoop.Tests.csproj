<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure logic only: anything that touches Unity or game types can't load outside the game. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- xUnit v3 runs on Microsoft.Testing.Platform, so the test project is an executable. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The save-merge logic works on Json.NET; this is the version the game ships. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SilksongCoop/SilksongCoop.csproj" />
  </ItemGroup>

</Project>
