<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> so a user-level NuGet.Config cannot add or reorder feeds. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Each package comes from one feed only, so a same-named package on the other feed can't win. -->
  <packageSourceMapping>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
      <package pattern="UnityEngine.Modules" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
